{
 "questions": [
  {
   "key": "V1",
   "pillar": "V",
   "order": 1,
   "text": "Can the teacher see all student responses or outputs in real time?"
  },
  {
   "key": "V2",
   "pillar": "V",
   "order": 2,
   "text": "Does the tool show which students are stuck, progressing, or done?"
  },
  {
   "key": "V3",
   "pillar": "V",
   "order": 3,
   "text": "Can the teacher review student work after the session? (worksheets/tests/gap fills etc)"
  },
  {
   "key": "V4",
   "pillar": "V",
   "order": 4,
   "text": "Does the tool provide a quick check for understanding (e.g. polls, responses)?"
  },
  {
   "key": "V5",
   "pillar": "V",
   "order": 5,
   "text": "Can the teacher see learning across different English skills (reading, writing, speaking)?"
  },
  {
   "key": "I1",
   "pillar": "I",
   "order": 6,
   "text": "Does the tool offer multiple response modes (voice, text, multiple choice, drawing)?"
  },
  {
   "key": "I2",
   "pillar": "I",
   "order": 7,
   "text": "Can content or tasks be differentiated by level within the same class?"
  },
  {
   "key": "I3",
   "pillar": "I",
   "order": 8,
   "text": "Does the tool work on low-bandwidth connections and basic mobile devices?"
  },
  {
   "key": "I4",
   "pillar": "I",
   "order": 9,
   "text": "Is the interface simple enough for a first-time user?"
  },
  {
   "key": "I5",
   "pillar": "I",
   "order": 10,
   "text": "Does the tool include accessibility options (e.g. font size, audio support, captions)?"
  },
  {
   "key": "T1",
   "pillar": "T",
   "order": 11,
   "text": "Does the tool directly support the English skill being practised in this session?"
  },
  {
   "key": "T2",
   "pillar": "T",
   "order": 12,
   "text": "Does it work smoothly alongside other tools used in the same class period?"
  },
  {
   "key": "T3",
   "pillar": "T",
   "order": 13,
   "text": "Does it require the learner to actively do something (produce, respond, create)?"
  },
  {
   "key": "T4",
   "pillar": "T",
   "order": 14,
   "text": "Does the tool come with ready-made teacher resources — lesson plans, differentiation notes, extension tasks — so the teacher does not have to build the session from scratch?"
  },
  {
   "key": "T5",
   "pillar": "T",
   "order": 15,
   "text": "Can data or outputs be exported or integrated with the wider tech stack?"
  },
  {
   "key": "A1",
   "pillar": "A",
   "order": 16,
   "text": "Does the tool support pre-, mid-, and post-assessments? and adaptive diagnostic test?"
  },
  {
   "key": "A2",
   "pillar": "A",
   "order": 17,
   "text": "Can teachers run quick in-class checks for understanding?"
  },
  {
   "key": "A3",
   "pillar": "A",
   "order": 18,
   "text": "Are reports or dashboards easy to read without training?"
  },
  {
   "key": "A4",
   "pillar": "A",
   "order": 19,
   "text": "Can the teacher track student progress over multiple sessions?"
  },
  {
   "key": "A5",
   "pillar": "A",
   "order": 20,
   "text": "Does the assessment approach work fairly across different device types and contexts?"
  },
  {
   "key": "L1",
   "pillar": "L",
   "order": 21,
   "text": "Does the tool offer meaningful choices to the learner (what to practise, how, when)?"
  },
  {
   "key": "L2",
   "pillar": "L",
   "order": 22,
   "text": "Does it provide immediate and useful feedback directly to the student?"
  },
  {
   "key": "L3",
   "pillar": "L",
   "order": 23,
   "text": "Can students see their own goals or progress over time?"
  },
  {
   "key": "L4",
   "pillar": "L",
   "order": 24,
   "text": "Is there any peer interaction or collaborative feature built in?"
  },
  {
   "key": "L5",
   "pillar": "L",
   "order": 25,
   "text": "Is the learner more cognitively active than the teacher during this tool's use?"
  }
