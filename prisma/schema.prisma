generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  ADMIN
  PEDAGOGY_EVALUATOR
  TECHNICAL_EVALUATOR
  VITAL_EVALUATOR
  VIEWER
}

enum EvaluationState {
  IN_PROGRESS
  MERGED
  FINALISED
}

// Which evaluation track a Platform belongs to.
//   TOOL  → the Pedagogy/Technical scoring lifecycle (default, existing flow)
//   VITAL → the VITAL evaluator fills a linked VitalTool profile; on submit the
//           recommendation engine is recomputed.
enum EvaluationTrack {
  TOOL
  VITAL
}

enum EvaluatorType {
  PEDAGOGY
  TECHNICAL
  BOTH        // Scored by both PEDAGOGY and TECHNICAL evaluators
  VITAL       // Reserved for future Platform↔VitalTool linkage; standalone VITAL module does not use the scoring lifecycle
}

// Quality ranking (highest → lowest): TRIAL > DEMO > DOCUMENTATION > VENDOR_CLAIM
enum EvidenceType {
  TRIAL
  DEMO
  DOCUMENTATION
  VENDOR_CLAIM
}

enum WeightLevel {
  HIGH   // multiplier 3
  MEDIUM // multiplier 2
  LOW    // multiplier 1
}

enum PlatformStatus {
  ACTIVE
  DISQUALIFIED
}

enum CEFRLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum LearningLevel {
  EARLY_CHILDHOOD
  K12
  HIGHER_ED
  ADULT_LEARNING
  PROFESSIONAL
}

enum Skill {
  READING
  WRITING
  LISTENING
  SPEAKING
  GRAMMAR
  VOCABULARY
  PRONUNCIATION
}

enum DeploymentMode {
  CLOUD
  ON_PREMISE
  HYBRID
}

enum LicenceType {
  PERPETUAL
  SUBSCRIPTION
  PER_SEAT
  SITE_LICENCE
  OPEN_SOURCE
}

enum Team {
  STRATEGY_1
  STRATEGY_2
  STRATEGY_3
  STRATEGY_4
  STRATEGY_5
  STRATEGY_6
  LEARNING_SCIENCES
  EMERGING_TECHNOLOGY
  RESEARCH_AND_INNOVATION
  STEERING_COMMITTEE
}

enum AccessRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─── VITAL module enums ─────────────────────────────────────────────────────────

// The five VITAL pillars: Visible learning, Inclusive pedagogy, right Technology,
// Assessment for learning, Learner agency.
enum VitalPillar {
  V
  I
  T
  A
  L
}

// Per-pillar tool rating (Tool Landscape "VITAL RATING" columns).
enum VitalRating {
  Y
  P
  N
}

// Skill coverage + CEFR-level presence. Normalises Y/P/N, Yes/No/P, and ✓/— from the sheets.
enum VitalCoverage {
  FULL    // Y / Yes / ✓
  PARTIAL // P
  NONE    // N / No / —
  NA      // N/A
}

// Per-skill teacher dependency (Tool Landscape "TEACHER DEPENDENCY" columns: TL / P / S / N/A).
enum VitalDependency {
  TEACHER_LED    // TL
  PARTIAL        // P
  STUDENT        // S
  NOT_APPLICABLE // N/A
}

// Tool-level and recommendation core/supp dependency ("Overall dep." / "Core dep" / "Supp dep").
enum VitalToolDependency {
  FULLY_TEACHER_LED
  MOSTLY_TEACHER_LED
  BLENDED
  MOSTLY_INDEPENDENT
  FULLY_INDEPENDENT
}

// "De facto risk" column.
enum VitalRisk {
  LOW
  MEDIUM
  HIGH
}

// "Verdict" column.
enum VitalVerdict {
  POOR_FIT
  PARTIAL_FIT
  GOOD_FIT
  STRONG_FIT
}

// Tool "Role" column across sheets (Core / Supplementary / Resource bank / Teacher tool only / assessment).
enum VitalToolRole {
  CORE
  SUPPLEMENTARY
  RESOURCE_BANK
  TEACHER_TOOL
  ASSESSMENT
}

// Recommendation combined-stack VITAL status (✅ all pillars / ⚠ 1 gap / ⛔ 2+ gaps).
enum VitalComplianceStatus {
  COMPLIANT
  ONE_GAP
  MULTI_GAP
}

// One answer to a VITAL checklist question. Points: YES=2, PARTIAL=1, NO=0;
// NA is excluded from both the score and the max (denominator).
enum VitalAnswer {
  YES
  PARTIAL
  NO
  NA
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  name               String
  passwordHash       String
  role               Role
  team               Team?
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  resetToken         String?   @unique
  resetTokenExpiry   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  assignments                EvaluatorAssignment[]
  scores                     Score[]
  scoreAuditLogs             ScoreAuditLog[]
  conflictMessages           ConflictMessage[]
  closedThreads              ConflictThread[]
  platformAssignments        PlatformEvaluatorAssignment[]
  teamMerges                 EvaluationTeamMerge[]
  searchEvaluations          SearchEvaluation[]
  reviewedAccessRequests     AccessRequest[]
  vitalImports               VitalImportLog[]
  ageRanges                  PlatformAgeRange[]
  closedAgeRangeConflicts    AgeRangeConflict[]          @relation("AgeRangeConflictClosedBy")
  ageRangeConflictMessages   AgeRangeConflictMessage[]   @relation("AgeRangeConflictMessageAuthor")
}

model Platform {
  id             String         @id @default(cuid())
  name           String
  vendor         String
  status         PlatformStatus @default(ACTIVE)
  track          EvaluationTrack @default(TOOL)
  licenceType    LicenceType?
  trialAvailable Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  evaluations          Evaluation[]
  contexts             PlatformContext[]
  evaluatorAssignments PlatformEvaluatorAssignment[]
  vitalTools           VitalTool[]
}

// Central aggregate for one scoring run on a Platform.
// Owns the state machine. Platform can have multiple Evaluations over time.
model Evaluation {
  id         String          @id @default(cuid())
  platformId String
  state      EvaluationState @default(IN_PROGRESS)
  lockedAt   DateTime?       // set when state transitions to FINALISED
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  platform         Platform              @relation(fields: [platformId], references: [id])
  assignments      EvaluatorAssignment[]
  scores           Score[]
  conflictThreads  ConflictThread[]
  teamMerges       EvaluationTeamMerge[]
  ageRanges        PlatformAgeRange[]
  ageRangeConflict AgeRangeConflict?
}

// Links a User to an Evaluation with an explicit team role.
// Tracks per-evaluator submission state for the IN_PROGRESS → MERGED gate.
model EvaluatorAssignment {
  id            String        @id @default(cuid())
  evaluationId  String
  userId        String
  evaluatorType EvaluatorType
  isLead        Boolean       @default(false)
  hasSubmitted  Boolean       @default(false)
  submittedAt   DateTime?
  createdAt     DateTime      @default(now())

  evaluation Evaluation @relation(fields: [evaluationId], references: [id])
  user       User       @relation(fields: [userId], references: [id])

  @@unique([evaluationId, userId])
}

model Context {
  id             String         @id @default(cuid())
  name           String         @unique
  description    String?
  learningLevels LearningLevel[]
  cefrMin        CEFRLevel?
  cefrMax        CEFRLevel?
  skills         Skill[]
  deploymentMode DeploymentMode?
  createdAt      DateTime       @default(now())

  platforms    PlatformContext[]
  requirements RequirementContext[]
}

model PlatformContext {
  platformId String
  contextId  String

  platform Platform @relation(fields: [platformId], references: [id])
  context  Context  @relation(fields: [contextId], references: [id])

  @@id([platformId, contextId])
}

model Requirement {
  id              String        @id @default(cuid())
  title           String
  description     String
  evaluatorType   EvaluatorType
  weight          WeightLevel
  // FAIL on a compliance gate requirement immediately disqualifies the Platform
  isComplianceGate Boolean      @default(false)
  category        String?
  order           Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  contexts        RequirementContext[]
  scores          Score[]
  conflictThreads ConflictThread[]
}

model RequirementContext {
  requirementId  String
  contextId      String
  // When set, overrides the requirement's global weight for scoring within this context only
  weightOverride WeightLevel?

  requirement Requirement @relation(fields: [requirementId], references: [id])
  context     Context     @relation(fields: [contextId], references: [id])

  @@id([requirementId, contextId])
}

// One evaluator's score for one requirement within one evaluation.
// value: null = N/A (excluded from weighted calc); 0 = FAIL (compliance gate only); 1-4 = numeric.
// Score isolation is enforced at the API layer - during IN_PROGRESS, cross-team scores are never returned.
model Score {
  id            String       @id @default(cuid())
  evaluationId  String
  requirementId String
  userId        String
  value         Int?
  evidenceType  EvidenceType?
  comment       String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  evaluation  Evaluation      @relation(fields: [evaluationId], references: [id])
  requirement Requirement     @relation(fields: [requirementId], references: [id])
  user        User            @relation(fields: [userId], references: [id])
  auditLogs   ScoreAuditLog[]

  @@unique([evaluationId, requirementId, userId])
}

// Immutable audit trail - one row per score write (create or update).
// Never update or delete rows from this table.
model ScoreAuditLog {
  id                  String        @id @default(cuid())
  scoreId             String
  changedById         String
  previousValue       Int?
  newValue            Int?
  previousEvidenceType EvidenceType?
  newEvidenceType     EvidenceType?
  previousComment     String?
  newComment          String?
  // Required when an admin reopens a FINALISED evaluation
  reason              String?
  changedAt           DateTime      @default(now())

  score     Score @relation(fields: [scoreId], references: [id])
  changedBy User  @relation(fields: [changedById], references: [id])
}

// Auto-created when score diff > 1 between any two evaluators on the same requirement.
// All threads must be closed before Evaluation can advance from MERGED → FINALISED.
model ConflictThread {
  id            String    @id @default(cuid())
  evaluationId  String
  requirementId String
  isClosed      Boolean   @default(false)
  closedAt      DateTime?
  closedById    String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  evaluation  Evaluation       @relation(fields: [evaluationId], references: [id])
  requirement Requirement      @relation(fields: [requirementId], references: [id])
  closedBy    User?            @relation(fields: [closedById], references: [id])
  messages    ConflictMessage[]

  @@unique([evaluationId, requirementId])
}

// Direct platform-level evaluator assignment (separate from Evaluation assignments).
// Establishes who is responsible for evaluating this platform before an Evaluation is created.
model PlatformEvaluatorAssignment {
  id            String        @id @default(cuid())
  platformId    String
  userId        String
  evaluatorType EvaluatorType
  isLead        Boolean       @default(false)
  createdAt     DateTime      @default(now())

  platform Platform @relation(fields: [platformId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([platformId, userId])
}

// Append-only message log within a ConflictThread. Messages are never edited or deleted.
model ConflictMessage {
  id        String   @id @default(cuid())
  threadId  String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  thread ConflictThread @relation(fields: [threadId], references: [id])
  author User           @relation(fields: [authorId], references: [id])
}

// Layer 1 Search: AI-driven auto-evaluation of any platform from public web sources.
// Scores are stored as JSON { requirementId: 0|1|2|3|4|null } using the same 0–4 scale as PET.
model SearchEvaluation {
  id           String   @id @default(cuid())
  platformName String
  url          String
  metadata     Json?    // { Target_Audience: string, Fluency_Levels: string[], Grade_Levels: string[] }
  scores       Json     // { requirementId: number | null }
  createdAt    DateTime @default(now())
  createdById  String

  createdBy User @relation(fields: [createdById], references: [id])
}

// Access request submitted by someone who wants an account.
// Super Admin approves or rejects; approval creates the user account and emails temp password.
model AccessRequest {
  id            String              @id @default(cuid())
  email         String
  name          String
  team          Team
  requestedRole Role
  status        AccessRequestStatus @default(PENDING)
  notes         String?
  reviewedAt    DateTime?
  reviewedById  String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  reviewedBy User? @relation(fields: [reviewedById], references: [id])
}

// Records when a team lead merges their team's scores.
// One record per (evaluation, evaluatorType). Both teams must have a record
// before the evaluation can advance to MERGED.
model EvaluationTeamMerge {
  id            String        @id @default(cuid())
  evaluationId  String
  evaluatorType EvaluatorType
  mergedAt      DateTime      @default(now())
  mergedById    String

  evaluation Evaluation @relation(fields: [evaluationId], references: [id])
  mergedBy   User       @relation(fields: [mergedById], references: [id])

  @@unique([evaluationId, evaluatorType])
}

// ─── Age Range Assessment models ───────────────────────────────────────────────

// One evaluator's target-age-range submission per evaluation.
// ageMin / ageMax: 5–17 for specific school ages; 18 = "Adult (18+)".
// Grade is derived client-side: Grade = Age − 5 (Kindergarten for age 5).
model PlatformAgeRange {
  id            String        @id @default(cuid())
  evaluationId  String
  evaluation    Evaluation    @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  userId        String
  user          User          @relation(fields: [userId], references: [id])
  evaluatorType EvaluatorType
  ageMin        Int
  ageMax        Int
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@unique([evaluationId, userId])
}

// Created when evaluators' age-range submissions differ at MERGED transition.
// Must be closed (isClosed = true) before the evaluation can be FINALISED.
model AgeRangeConflict {
  id           String                   @id @default(cuid())
  evaluationId String                   @unique
  evaluation   Evaluation               @relation(fields: [evaluationId], references: [id], onDelete: Cascade)
  isClosed     Boolean                  @default(false)
  closedAt     DateTime?
  closedById   String?
  closedBy     User?                    @relation("AgeRangeConflictClosedBy", fields: [closedById], references: [id])
  createdAt    DateTime                 @default(now())
  messages     AgeRangeConflictMessage[]
}

// Discussion messages within an AgeRangeConflict. Append-only.
model AgeRangeConflictMessage {
  id         String           @id @default(cuid())
  conflictId String
  conflict   AgeRangeConflict @relation(fields: [conflictId], references: [id], onDelete: Cascade)
  userId     String
  user       User             @relation("AgeRangeConflictMessageAuthor", fields: [userId], references: [id])
  body       String
  createdAt  DateTime         @default(now())
}

// ─── VITAL module models ────────────────────────────────────────────────────────
// Standalone module: recreates the school's VITAL workbooks (tool catalogue, pillar
// ratings, skill coverage, CEFR mapping, recommendation/level-stack engines, assessment
// landscape). Seeded but fully editable. Decoupled from the Evaluation lifecycle.

// The six English skills (editable list). Source order: Vocabulary, Listening, Speaking, Reading, Writing, Grammar.
model VitalSkill {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  createdAt DateTime @default(now())

  skillCoverage   VitalToolSkillCoverage[]
  recommendations VitalRecommendation[]
}

// The 22-point CEFR sub-level scale (A0 + 21) plus the assessment-only "A0 (Pre)" row.
// scoreBand: "Pre-emergent" | "Up to 33%" | "34%–66%" | "67%–100%".
// cefrStatus: "Standard CEFR" | "Non-CEFR (school-defined)".
// bandGroup: A0 | A | B1 | B1.5 | B2 | B2.5 | C1.
model VitalLevel {
  id             String   @id @default(cuid())
  code           String   @unique // e.g. "A1−" (U+2212 minus), "B1.5+", "A0 (Pre)"
  label          String
  order          Int      @default(0)
  scoreBand      String
  cefrStatus     String
  bandGroup      String
  isPreEmergent  Boolean  @default(false)
  assessmentOnly Boolean  @default(false) // true only for the "A0 (Pre)" assessment-landscape column

  levelMappings        VitalToolLevelMapping[]
  recommendations      VitalRecommendation[]
  stageRecommendations VitalStageRecommendation[]
}

// A catalogue tool (28 teaching tools + 11 assessment/placement tools).
model VitalTool {
  id                String               @id @default(cuid())
  name              String               @unique
  role              VitalToolRole
  vitalScore10      Int?                 // legacy 0–10 (derived from pillar letters; kept for results scatter/filter)
  v2Score50         Int?                 // derived total /50 from the 25 question responses
  v2Percent         Int?                 // derived % of non-N/A max (0–100)
  verdict           VitalVerdict?        // derived from v2Score50: ≥35 STRONG · 25–34 GOOD · 15–24 PARTIAL · <15 POOR
  deFactoRisk       VitalRisk?
  overallDependency VitalToolDependency?
  belowA0           Boolean              @default(false)
  cefrRangeLabel    String?              // e.g. "A1− → C1+ — all skills, CEFR-aligned core"
  isAssessmentTool  Boolean              @default(false)
  adaptiveTesting   String?              // assessment tools only, e.g. "Yes (partial)", "No (fixed)"
  notes             String?
  platformId        String?              // optional link to a Platform (future results-filter integration)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  platform           Platform?                @relation(fields: [platformId], references: [id])
  pillarRatings      VitalToolPillarRating[]
  skillCoverage      VitalToolSkillCoverage[]
  levelMappings      VitalToolLevelMapping[]
  questionResponses  VitalQuestionResponse[]
  coreRecommendations VitalRecommendation[]   @relation("CoreTool")
  suppRecommendations VitalRecommendation[]   @relation("SuppTool")
}

// One pillar rating for one tool (5 rows per tool).
// `rating` defaults to the value derived from the pillar's /10 question score
// (≥7 → Y, ≥5 → P, else N). When isOverride is true the rating was set manually
// by an evaluator/admin whose judgement differed; overrideNote captures why.
model VitalToolPillarRating {
  id           String      @id @default(cuid())
  toolId       String
  pillar       VitalPillar
  rating       VitalRating
  isOverride   Boolean     @default(false)
  overrideNote String?

  tool VitalTool @relation(fields: [toolId], references: [id], onDelete: Cascade)

  @@unique([toolId, pillar])
}

// One skill's coverage + teacher dependency for one tool (6 rows per tool).
// dependency is null for assessment tools.
model VitalToolSkillCoverage {
  id         String           @id @default(cuid())
  toolId     String
  skillId    String
  coverage   VitalCoverage
  dependency VitalDependency?

  tool  VitalTool  @relation(fields: [toolId], references: [id], onDelete: Cascade)
  skill VitalSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([toolId, skillId])
}

// Presence/coverage of one tool at one CEFR level.
model VitalToolLevelMapping {
  id       String        @id @default(cuid())
  toolId   String
  levelId  String
  coverage VitalCoverage

  tool  VitalTool  @relation(fields: [toolId], references: [id], onDelete: Cascade)
  level VitalLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([toolId, levelId])
}

// The 132 recommendation combos (6 skills × 22 levels). Powers the Recommendation Engine,
// Level Stack Engine, and both Full Grid views. Pillar fields hold the combined core+supp coverage.
model VitalRecommendation {
  id             String                @id @default(cuid())
  skillId        String
  levelId        String
  coreToolId     String?
  suppToolId     String?
  // When true the slot's tool is admin-pinned (override); when false the tool
  // is auto-derived from the catalogue. Downstream fields always cascade from
  // the effective core/supp. See lib/vital/derive.ts.
  coreToolLocked Boolean             @default(false)
  suppToolLocked Boolean             @default(false)
  coreDependency VitalToolDependency?
  suppDependency VitalToolDependency?
  coreRisk       VitalRisk?
  suppRisk       VitalRisk?
  pillarV        VitalCoverage
  pillarI        VitalCoverage
  pillarT        VitalCoverage
  pillarA        VitalCoverage
  pillarL        VitalCoverage
  status         VitalComplianceStatus
  deploymentNote String?

  skill    VitalSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level    VitalLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)
  coreTool VitalTool? @relation("CoreTool", fields: [coreToolId], references: [id])
  suppTool VitalTool? @relation("SuppTool", fields: [suppToolId], references: [id])

  @@unique([skillId, levelId])
}

// Audit trail for xlsx imports.
model VitalImportLog {
  id           String   @id @default(cuid())
  importedById String
  fileName     String
  workbookType String
  created      Int      @default(0)
  updated      Int      @default(0)
  skipped      Int      @default(0)
  detail       Json?
  importedAt   DateTime @default(now())

  importedBy User @relation(fields: [importedById], references: [id])
}

// ─── VITAL Model 2.0: question-driven evaluation + stage matrix ──────────────────

// The 25 VITAL checklist questions (5 per pillar). `key` is stable (e.g. "V1").
model VitalQuestion {
  id        String      @id @default(cuid())
  key       String      @unique
  pillar    VitalPillar
  order     Int         @default(0)
  text      String
  createdAt DateTime    @default(now())

  responses VitalQuestionResponse[]
}

// One tool's answer to one question. The per-pillar /10, total /50, %-score and
// verdict are all derived from these rows (see lib/vital/compute.ts).
model VitalQuestionResponse {
  id         String      @id @default(cuid())
  toolId     String
  questionId String
  answer     VitalAnswer

  tool     VitalTool     @relation(fields: [toolId], references: [id], onDelete: Cascade)
  question VitalQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([toolId, questionId])
}

// A period stage (row dimension of the CEFR × Stage × Tools matrix). 9 rows.
// `pillars` holds the stage's primary VITAL pillar(s), e.g. ["T","I"].
model VitalStage {
  id        String   @id @default(cuid())
  key       String   @unique
  order     Int      @default(0)
  pillars   String[]
  createdAt DateTime @default(now())

  recommendations VitalStageRecommendation[]
}

// One cell of the stage × level matrix: authored core/supp tool text + VITAL note.
// Cells hold human-authored multi-tool lists ("Starfall · ICT Games"), not single
// tool FKs — so the text is stored verbatim. 9 stages × 22 levels = 198 rows.
model VitalStageRecommendation {
  id        String @id @default(cuid())
  stageId   String
  levelId   String
  coreText  String?
  suppText  String?
  vitalNote String?

  stage VitalStage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  level VitalLevel @relation(fields: [levelId], references: [id], onDelete: Cascade)

  @@unique([stageId, levelId])
}

// Read-only Grade Band ↔ CEFR range reference (K–5 / 6–8 / 9–12 × learner level).
// Connects to the platform age-range feature via Grade = Age − 5.
model VitalGradeBand {
  id           String   @id @default(cuid())
  band         String
  learnerLevel String
  cefrRange    String
  order        Int      @default(0)
  createdAt    DateTime @default(now())

  @@unique([band, learnerLevel])
}
